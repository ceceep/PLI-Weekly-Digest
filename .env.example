# Copy this to .env and fill in your actual values

# Anthropic API key for syllabus parsing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SendGrid API key for email sending
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Your email address (will send emails from this)
FROM_EMAIL=your-email@example.com

# Flask secret key (generate a random string)
SECRET_KEY=generate-a-random-secret-key-here

# Database URL (defaults to SQLite locally, can use PostgreSQL in production)
DATABASE_URL=sqlite:///pli_digest.db
